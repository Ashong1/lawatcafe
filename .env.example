APP_NAME="Lawa't Kape"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Sales, shifts and reports are reckoned in this timezone.
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# sqlite is enough to try the app out; production runs MySQL/MariaDB:
# DB_CONNECTION=mysql and fill in the lines below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lawat_db
# DB_USERNAME=lawat
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Barista AI. One OpenRouter key; without it the AI features say they are
# unavailable and everything else works. https://openrouter.ai/keys
OPENROUTER_API_KEY=

OPNSENSE_IP=192.168.2.251
OPNSENSE_API_URL=https://192.168.2.251
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
OPNSENSE_ZONE=0
OPNSENSE_GUEST_USER=laravel_guest
OPNSENSE_GUEST_PASS=
# Name of a pre-existing MAC-type Firewall alias (Firewall > Aliases) that a
# block rule on the guest interface references. The app only manages this
# alias's membership via alias_util — it does not create the alias or rule.
OPNSENSE_BLOCK_ALIAS=guest_blocklist

# Speed-plan groups on OPNsense (Firewall > Aliases, type Host). The app keeps
# their members in step with who is signed in on which plan.
OPNSENSE_TIER_ALIAS_FREE=lawatcafe_free_tier
OPNSENSE_TIER_ALIAS_PREMIUM=lawatcafe_premium_tier
# Same-LAN firewalls usually have a self-signed certificate. Set true once
# OPNsense has a certificate this server trusts.
OPNSENSE_VERIFY_TLS=false

# Pi-hole v6: site blocking, adult-site alerts and the DNS health check.
# Create an app password in Pi-hole under Settings > Web interface / API.
PIHOLE_URL=http://192.168.2.4
PIHOLE_APP_PASSWORD=

# The guest Wi-Fi login page: plain HTTP on its own hostname (see
# docs/CAPTIVE_PORTAL.md for why it is not HTTPS).
PORTAL_HOST=wifi.lawatkape.lab
PORTAL_IP=192.168.2.100

# Accounts created by `php artisan db:seed`. Leave a password empty and one is
# generated and printed once. Never commit real values.
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=
