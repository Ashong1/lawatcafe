<?xml version="1.0" encoding="utf-8"?>
<!-- The app uses https://lawatkape.aserotech.com (publicly trusted). Plain
     HTTP is allowed only for the shop's own local addresses, which the app
     falls back to when that name can't be reached; everything else must be
     HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.2.100</domain>
        <domain includeSubdomains="true">lawatkape.lab</domain>
    </domain-config>
</network-security-config>
